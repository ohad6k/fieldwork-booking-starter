    "seed": "node scripts/seed.mjs",
    "seed:check": "node scripts/seed.mjs --check"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.2",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "prettier": "3.10.1"
  }
}
